---
/**
 * dusrelpdf playground — run real PDF operations in the browser.
 *
 * The Rust core, compiled to WASM with wasm-pack (`--target web`), is
 * lazy-loaded ONLY on this page, ONLY on first use, from
 * `/wasm/dusrelpdf_wasm.js` (built by `npm run build` via
 * scripts/build-wasm.mjs). Files NEVER leave the browser: the WASM runs
 * locally, and downloads are created with object URLs.
 *
 * There is NO fallback here on purpose. If the WASM build is missing the
 * page says so loudly — silently pretending to work would be worse.
 */
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Playground — dusrelpdf</title>
		<meta
			name="description"
			content="Try dusrelpdf in your browser: merge, extract, rotate, watermark and number real PDFs with the Rust core compiled to WebAssembly. Your files never leave the browser."
		/>
		<meta property="og:title" content="Playground — dusrelpdf" />
		<meta property="og:description" content="Run real PDF operations in your browser. No file leaves the page." />
		<meta property="og:url" content="https://dusrelpdf.pages.dev/playground/" />
		<meta property="og:image" content="https://dusrelpdf.pages.dev/og.svg" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href="https://dusrelpdf.pages.dev/playground/" />
		<style>
			:root { --bg: #0f172a; --card: #1e293b; --ink: #f8fafc; --muted: #94a3b8; --green: #22c55e; --red: #f87171; --amber: #fbbf24; --line: #334155; }
			* { box-sizing: border-box; }
			body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; background: var(--bg); color: var(--ink); line-height: 1.6; }
			a { color: #4ade80; }
			.wrap { max-width: 960px; margin: 0 auto; padding: 0 20px 64px; }
			header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; }
			.logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.25rem; color: var(--ink); text-decoration: none; }
			.logo img { width: 32px; height: 32px; }
			nav a { color: var(--muted); text-decoration: none; margin-left: 20px; font-weight: 600; }
			nav a:hover { color: var(--ink); }
			h1 { font-size: 2rem; margin: 24px 0 4px; }
			.sub { color: var(--muted); margin: 0 0 24px; }
			.panel { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 20px; margin-bottom: 16px; }
			.panel h2 { font-size: 1.05rem; margin: 0 0 12px; }
			label { display: block; font-weight: 600; margin: 12px 0 4px; }
			label span { color: var(--muted); font-weight: 400; font-size: 0.9rem; }
			input[type="file"], input[type="text"], input[type="number"], select { width: 100%; background: #020617; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 11px 12px; font-size: 1rem; }
			input[type="file"] { cursor: pointer; }
			.row { display: flex; gap: 12px; flex-wrap: wrap; }
			.row > div { flex: 1 1 200px; }
			.tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
			.tabs button { background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 9px 18px; cursor: pointer; font-weight: 600; font-size: 0.95rem; }
			.tabs button[aria-pressed="true"] { background: var(--green); color: #052e12; border-color: var(--green); }
			.btn { border: none; border-radius: 8px; padding: 13px 22px; font-weight: 700; cursor: pointer; font-size: 1rem; margin-top: 16px; }
			.btn-primary { background: var(--green); color: #052e12; }
			.btn:disabled { opacity: 0.5; cursor: not-allowed; }
			.filelist { margin: 10px 0 0; padding: 0; list-style: none; font-size: 0.95rem; color: var(--muted); }
			.filelist li { padding: 2px 0; }
			.result { margin-top: 16px; border-radius: 10px; padding: 16px; display: none; }
			.result.show { display: block; }
			.result.ok { background: #052e12; border: 1px solid #166534; }
			.result.err { background: #450a0a; border: 1px solid #991b1b; }
			.result .verdict { font-weight: 800; font-size: 1.05rem; }
			.result .verdict.ok { color: var(--green); }
			.result .verdict.err { color: var(--red); }
			.result code { color: #e2e8f0; }
			.result .reason-hi { color: var(--muted); }
			.result a { display: inline-block; margin: 6px 10px 0 0; font-weight: 700; }
			.engine { font-size: 0.85rem; color: var(--muted); margin-top: 12px; }
			.note { background: #451a03; border: 1px solid #92400e; border-radius: 12px; padding: 16px 18px; margin-top: 32px; color: #fde68a; font-size: 0.95rem; }
			.note a { color: #fcd34d; }
			footer { margin-top: 48px; border-top: 1px solid var(--line); padding-top: 20px; color: var(--muted); font-size: 0.9rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
		</style>
	</head>
	<body>
		<div class="wrap">
			<header>
				<a class="logo" href="/"><img src="/favicon.svg" alt="" /> dusrelpdf</a>
				<nav>
					<a href="/guides/installation/">Docs</a>
					<a href="/playground/">Playground</a>
					<a href="https://github.com/dusmamud/dusrelpdf">GitHub</a>
				</nav>
			</header>

			<h1>Playground</h1>
			<p class="sub">
				Run real PDF operations in your browser — the same Rust core as the
				package, compiled to WebAssembly. <strong>Your files never leave this
				page:</strong> nothing is uploaded anywhere, and the result is
				downloaded straight from your browser.
			</p>

			<div class="tabs" role="group" aria-label="Operation" id="tabs"></div>

			<div class="panel">
				<h2>1. Pick a PDF</h2>
				<label for="file-input">PDF file <span id="file-hint">(one file)</span></label>
				<input id="file-input" type="file" accept="application/pdf,.pdf" />
				<ul class="filelist" id="file-list"></ul>
				<p class="engine" id="info-line">No file loaded yet.</p>
				<p>
					No PDF handy?
					<button type="button" id="mock-btn" style="background:none;border:none;color:#4ade80;cursor:pointer;padding:0;font-size:1rem;text-decoration:underline;">Generate a 3-page test PDF</button>
					(test data only — each page says "Page &lt;n&gt;").
				</p>
			</div>

			<div class="panel" id="opts-panel">
				<h2>2. Options</h2>
				<div id="opts"></div>
				<button type="button" class="btn btn-primary" id="run-btn" disabled>Run</button>
				<p class="engine" id="engine">Engine: not loaded yet — it loads on first run.</p>
			</div>

			<div class="panel" id="out-panel" style="display:none">
				<h2>3. Result</h2>
				<div id="result" class="result" aria-live="polite"></div>
			</div>

			<div class="note">
				<strong>Honest limits:</strong> the playground runs the real v0.1.0 core,
				so the same limits apply — no rendering, no repair of malformed PDFs,
				merge drops the original outline trees, watermark text is ASCII only,
				and signature placement is an image, not a digital signature.
				<a href="/reference/limitations/">Read the limitations →</a>
			</div>

			<footer>
				<span>dusrelpdf — open source, by dusmamud.</span>
				<span><a href="/guides/installation/">Docs</a> · <a href="/">Home</a> · <a href="https://github.com/dusmamud/dusrelpdf">GitHub</a></span>
			</footer>
		</div>

		<script>
			// ------------------------------------------------------------ WASM
			// Lazy-loaded ONLY on this page, ONLY on first run.
			// If the build is missing, this throws and we show a loud error —
			// there is deliberately NO fallback that pretends to work.
			let wasmModule = undefined; // undefined = not tried, null = failed
			async function loadWasm() {
				if (wasmModule !== undefined) {
					if (wasmModule === null) throw new Error('WASM engine failed to load earlier — the playground build is missing. Re-run `npm run build` (it runs wasm-pack first).');
					return wasmModule;
				}
				try {
					const mod = await import(/* @vite-ignore */ '/wasm/dusrelpdf_wasm.js');
					await mod.default();
					wasmModule = mod;
					document.querySelector('#engine').textContent = `Engine: WASM (Rust core, dusrelpdf ${mod.version()}).`;
					return mod;
				} catch (e) {
					wasmModule = null;
					document.querySelector('#engine').textContent = 'Engine: FAILED TO LOAD — the WASM build is missing. See the error below.';
					throw new Error(`Could not load the WASM engine (/wasm/dusrelpdf_wasm.js): ${e.message}. The playground needs \`npm run build\` (wasm-pack) first.`);
				}
			}

			function parseThrown(e) {
				// WASM errors are thrown as JSON strings:
				// {"ok":false,"code":"...","reason_en":"...","reason_hi":"..."}
				if (typeof e === 'string') {
					try { return JSON.parse(e); } catch { return { code: 'OPERATION_FAILED', reason_en: e, reason_hi: '' }; }
				}
				if (e && e.message) return { code: 'OPERATION_FAILED', reason_en: e.message, reason_hi: '' };
				return { code: 'OPERATION_FAILED', reason_en: String(e), reason_hi: '' };
			}

			// -------------------------------------------------------------- ops
			const OPS = [
				{ id: 'merge', label: 'Merge', multi: true, hint: '(two or more files, in order)' },
				{ id: 'extract', label: 'Extract', multi: false, hint: '(one file)' },
				{ id: 'rotate', label: 'Rotate', multi: false, hint: '(one file)' },
				{ id: 'watermark', label: 'Watermark', multi: false, hint: '(one file)' },
				{ id: 'numbers', label: 'Page numbers', multi: false, hint: '(one file)' },
				{ id: 'split', label: 'Split (per page)', multi: false, hint: '(one file)' },
			];

			let currentOp = 'merge';
			let files = []; // [{ name, bytes: Uint8Array }]
			let mockMode = false;

			const $ = (s) => document.querySelector(s);
			const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

			function renderTabs() {
				const el = $('#tabs');
				el.innerHTML = '';
				for (const op of OPS) {
					const b = document.createElement('button');
					b.type = 'button';
					b.textContent = op.label;
					b.setAttribute('aria-pressed', String(op.id === currentOp));
					b.addEventListener('click', () => setOp(op.id));
					el.appendChild(b);
				}
			}

			function optField(id, label, inner) {
				return `<label for="${id}">${label}</label>${inner}`;
			}

			function renderOpts() {
				const el = $('#opts');
				const op = OPS.find((o) => o.id === currentOp);
				$('#file-hint').textContent = op.hint;
				$('#file-input').multiple = op.multi;
				if (currentOp === 'extract') {
					el.innerHTML = optField('opt-range', 'Pages <span>range string, e.g. 1-3,5 — pages are 1-based</span>',
						'<input type="text" id="opt-range" value="1-3,5" spellcheck="false" />');
				} else if (currentOp === 'rotate') {
					el.innerHTML = `
						<div class="row"><div>${optField('opt-angle', 'Angle <span>must be a multiple of 90°</span>',
							'<select id="opt-angle"><option value="90" selected>90°</option><option value="180">180°</option><option value="270">270°</option><option value="-90">-90° (= 270°)</option></select>')}</div>
						<div>${optField('opt-pages', 'Pages <span>blank = all pages, e.g. 1,3</span>',
							'<input type="text" id="opt-pages" placeholder="all pages" spellcheck="false" />')}</div></div>`;
				} else if (currentOp === 'watermark') {
					el.innerHTML = `
						<div class="row"><div>${optField('opt-text', 'Watermark text <span>ASCII only</span>',
							'<input type="text" id="opt-text" value="DRAFT" spellcheck="false" />')}</div>
						<div>${optField('opt-opacity', 'Opacity <span>0.0–1.0</span>',
							'<input type="number" id="opt-opacity" value="0.3" min="0" max="1" step="0.05" />')}</div></div>
						<div class="row"><div>${optField('opt-rotation', 'Rotation <span>degrees, clockwise</span>',
							'<input type="number" id="opt-rotation" value="45" step="5" />')}</div>
						<div>${optField('opt-wmpages', 'Pages <span>blank = all pages, e.g. 1-2</span>',
							'<input type="text" id="opt-wmpages" placeholder="all pages" spellcheck="false" />')}</div></div>`;
				} else if (currentOp === 'numbers') {
					el.innerHTML = `
						<div class="row"><div>${optField('opt-format', 'Format <span>must contain {n}</span>',
							'<input type="text" id="opt-format" value="Page {n} of {total}" spellcheck="false" />')}</div>
						<div>${optField('opt-position', 'Position',
							'<select id="opt-position"><option value="bottom_center" selected>Bottom centre</option><option value="top_center">Top centre</option><option value="bottom_right">Bottom right</option><option value="bottom_left">Bottom left</option><option value="top_left">Top left</option><option value="top_right">Top right</option><option value="center">Centre</option></select>')}</div></div>
						<div class="row"><div>${optField('opt-start', 'First number',
							'<input type="number" id="opt-start" value="1" min="0" step="1" />')}</div>
						<div>${optField('opt-fontsize', 'Font size <span>points</span>',
							'<input type="number" id="opt-fontsize" value="10" min="6" max="48" step="1" />')}</div></div>`;
				} else if (currentOp === 'split') {
					el.innerHTML = '<p style="color: var(--muted); margin: 0;">One output file per page. No options needed.</p>';
				} else {
					el.innerHTML = '<p style="color: var(--muted); margin: 0;">Merges the files in the order listed above. No options needed.</p>';
				}
				updateRunButton();
			}

			function setOp(id) {
				currentOp = id;
				renderTabs();
				renderOpts();
			}

			function updateRunButton() {
				$('#run-btn').disabled = files.length === 0;
			}

			function parsePageList(s) {
				return s.split(',').map((p) => parseInt(p.trim(), 10)).filter((n) => Number.isFinite(n) && n > 0);
			}

			function downloadLink(bytes, filename, label) {
				const blob = new Blob([bytes], { type: 'application/pdf' });
				const url = URL.createObjectURL(blob);
				const a = document.createElement('a');
				a.href = url;
				a.download = filename;
				a.textContent = label || filename;
				return a;
			}

			function showResult(ok, html) {
				const r = $('#result');
				$('#out-panel').style.display = 'block';
				r.className = `result show ${ok ? 'ok' : 'err'}`;
				r.innerHTML = html;
			}

			function showError(err) {
				showResult(false, `
					<div class="verdict err">✗ ${esc(err.code || 'OPERATION_FAILED')}</div>
					<div>${esc(err.reason_en || '')}</div>
					${err.reason_hi ? `<div class="reason-hi">${esc(err.reason_hi)}</div>` : ''}
					<p style="color: var(--muted); font-size: 0.9rem;">See <a href="/guides/error-codes/">all error codes →</a></p>`);
			}

			async function refreshInfo() {
				if (files.length === 0) {
					$('#info-line').textContent = 'No file loaded yet.';
					return;
				}
				try {
					const mod = await loadWasm();
					if (files.length === 1) {
						const info = JSON.parse(mod.get_pdf_info(files[0].bytes));
						$('#info-line').textContent = `${files[0].name}: ${info.page_count} pages, PDF ${info.version}, encrypted: ${info.encrypted}${info.title ? `, title: ${info.title}` : ''}`;
					} else {
						$('#info-line').textContent = `${files.length} files selected for merge.`;
					}
				} catch (e) {
					$('#info-line').textContent = 'Could not read PDF info yet — it will be checked when you run.';
				}
			}

			$('#file-input').addEventListener('change', async (ev) => {
				files = [];
				mockMode = false;
				for (const f of ev.target.files) {
					files.push({ name: f.name, bytes: new Uint8Array(await f.arrayBuffer()) });
				}
				const list = $('#file-list');
				list.innerHTML = '';
				for (const f of files) list.appendChild(Object.assign(document.createElement('li'), { textContent: `${f.name} — ${(f.bytes.length / 1024).toFixed(1)} KB` }));
				updateRunButton();
				await refreshInfo();
			});

			$('#mock-btn').addEventListener('click', async () => {
				try {
					const mod = await loadWasm();
					const bytes = mod.make_test_pdf(3);
					files = [{ name: 'mock-3-pages.pdf', bytes }];
					mockMode = true;
					const list = $('#file-list');
					list.innerHTML = '';
					list.appendChild(Object.assign(document.createElement('li'), { textContent: 'mock-3-pages.pdf — generated test PDF (3 pages)' }));
					updateRunButton();
					await refreshInfo();
				} catch (e) {
					showError(parseThrown(e));
				}
			});

			$('#run-btn').addEventListener('click', async () => {
				if (files.length === 0) return;
				const btn = $('#run-btn');
				btn.disabled = true;
				btn.textContent = 'Running…';
				try {
					const mod = await loadWasm();
					const first = files[0];
					let outName = 'dusrelpdf-output.pdf';
					if (currentOp === 'merge') {
						if (files.length < 2) throw new Error('Merge needs at least two files.');
						const out = mod.merge_pdfs(files.map((f) => f.bytes));
						outName = 'merged.pdf';
						showResult(true, `<div class="verdict ok">✓ Merged ${files.length} files</div><div>Output: ${out.length.toLocaleString()} bytes.</div>`);
						$('#result').appendChild(downloadLink(out, outName, `⬇ Download ${outName}`));
					} else if (currentOp === 'extract') {
						const range = ($('#opt-range')?.value || '1-3,5').trim();
						const out = mod.extract_pages_range(first.bytes, range);
						outName = 'excerpt.pdf';
						showResult(true, `<div class="verdict ok">✓ Extracted pages ${esc(range)}</div><div>Output: ${out.length.toLocaleString()} bytes.</div>`);
						$('#result').appendChild(downloadLink(out, outName, `⬇ Download ${outName}`));
					} else if (currentOp === 'rotate') {
						const angle = parseInt($('#opt-angle')?.value || '90', 10);
						const pagesRaw = ($('#opt-pages')?.value || '').trim();
						const opts = { angle };
						if (pagesRaw) opts.pages = parsePageList(pagesRaw);
						const out = mod.rotate_pages(first.bytes, opts);
						outName = 'rotated.pdf';
						showResult(true, `<div class="verdict ok">✓ Rotated by ${angle}°${pagesRaw ? ` (pages ${esc(pagesRaw)})` : ' (all pages)'}</div><div>Output: ${out.length.toLocaleString()} bytes.</div>`);
						$('#result').appendChild(downloadLink(out, outName, `⬇ Download ${outName}`));
					} else if (currentOp === 'watermark') {
						const text = ($('#opt-text')?.value || 'DRAFT').trim() || 'DRAFT';
						const opacity = parseFloat($('#opt-opacity')?.value || '0.3');
						const rotation = parseFloat($('#opt-rotation')?.value || '45');
						const pagesRaw = ($('#opt-wmpages')?.value || '').trim();
						const opts = { text, opacity, rotation };
						if (pagesRaw) {
							const expanded = [];
							for (const part of pagesRaw.split(',')) {
								const [a, b] = part.split('-').map((x) => parseInt(x.trim(), 10));
								if (Number.isFinite(a) && Number.isFinite(b) && b >= a) { for (let n = a; n <= b; n++) expanded.push(n); }
								else if (Number.isFinite(a)) expanded.push(a);
							}
							opts.pages = expanded;
						}
						const out = mod.add_watermark(first.bytes, opts);
						outName = 'watermarked.pdf';
						showResult(true, `<div class="verdict ok">✓ Watermarked with "${esc(text)}"</div><div>Output: ${out.length.toLocaleString()} bytes.</div>`);
						$('#result').appendChild(downloadLink(out, outName, `⬇ Download ${outName}`));
					} else if (currentOp === 'numbers') {
						const format = ($('#opt-format')?.value || '{n}').trim() || '{n}';
						const position = $('#opt-position')?.value || 'bottom_center';
						const start_at = parseInt($('#opt-start')?.value || '1', 10);
						const font_size = parseFloat($('#opt-fontsize')?.value || '10');
						const out = mod.add_page_numbers(first.bytes, { format, position, start_at, font_size });
						outName = 'numbered.pdf';
						showResult(true, `<div class="verdict ok">✓ Numbered pages (${esc(format)})</div><div>Output: ${out.length.toLocaleString()} bytes.</div>`);
						$('#result').appendChild(downloadLink(out, outName, `⬇ Download ${outName}`));
					} else if (currentOp === 'split') {
						const parts = mod.split_each_page(first.bytes);
						showResult(true, `<div class="verdict ok">✓ Split into ${parts.length} files</div><div>Download each page:</div>`);
						parts.forEach((part, i) => {
							$('#result').appendChild(downloadLink(part, `page-${i + 1}.pdf`, `⬇ page-${i + 1}.pdf`));
						});
					}
				} catch (e) {
					showError(parseThrown(e));
				} finally {
					btn.disabled = files.length === 0;
					btn.textContent = 'Run';
				}
			});

			renderTabs();
			renderOpts();
		</script>
	</body>
</html>
